{
  "name": "chromamancer",
  "version": "0.1.0",
  "description": "Master the arcane art of theme transformation between VS Code and Obsidian",
  "private": true,
  "author": "L V N A C Y",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/chromamancer.git"
  },
  "keywords": [
    "theme",
    "vscode",
    "obsidian",
    "converter",
    "color",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "type-check": "pnpm -r type-check",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  }
}